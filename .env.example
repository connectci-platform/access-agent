# Environment
ENVIRONMENT=production  # local, docker, production

# =============================================================================
# OpenTelemetry / Observability (Honeycomb)
# =============================================================================
# Set OTEL_ENABLED=false to disable telemetry entirely
OTEL_ENABLED=true
OTEL_SERVICE_NAME=access-agent

# Honeycomb OTLP endpoint
OTEL_EXPORTER_OTLP_ENDPOINT=https://api.honeycomb.io

# Honeycomb API key (get from Honeycomb > Team Settings > API Keys)
OTEL_EXPORTER_OTLP_HEADERS=x-honeycomb-team=your-honeycomb-api-key

# Dataset name (should match across all ACCESS-CI services)
HONEYCOMB_DATASET=access-ci

# Without OTLP endpoint configured, traces go to console (useful for local dev)

# MCP Server Host (production)
MCP_SERVER_HOST=45.79.215.140

# LLM Provider
LLM_PROVIDER=openai  # openai, vllm, access_ai, fireworks

# OpenAI
OPENAI_API_KEY=sk-...
OPENAI_MODEL=gpt-4o

# Fireworks AI (fine-tuned ACCESS model)
# FIREWORKS_API_KEY=fw_...
# FIREWORKS_MODEL=accounts/apasquale/models/access-qa-pilot

# vLLM (self-hosted)
# VLLM_BASE_URL=http://localhost:8080/v1
# VLLM_API_KEY=
# VLLM_MODEL_NAME=your-fine-tuned-model

# ACCESS AI endpoint
# ACCESS_AI_BASE_URL=https://access-ai-grace1-external.ccs.uky.edu/access/chat/api/
# ACCESS_AI_API_KEY=

# =============================================================================
# JWT Authentication (ES256 + JWKS)
# =============================================================================
# Comma-separated list of "issuer=jwks_url" pairs.
# Each issuing site publishes its public key at a JWKS endpoint.
# Example: https://support.access-ci.org=https://support.access-ci.org/.well-known/jwks.json
TRUSTED_JWKS_URLS=
# Transition: accept acting_user from request body when no cookie is present
ALLOW_BODY_ACTING_USER=true

# Database (checkpointing)
DATABASE_URL=postgresql://postgres:postgres@localhost:5432/langgraph

# UKY RAG Endpoints (dual RAG: general ACCESS Q&A + XDMoD)
UKY_RAG_ENABLED=true
# Falls back to ACCESS_AI_API_KEY if not set
# UKY_RAG_API_KEY=
UKY_RAG_GENERAL_URL=https://access-ai-grace1-external.ccs.uky.edu/access/chat/api/
UKY_RAG_XDMOD_URL=https://access-ai-grace1-external.ccs.uky.edu/access/xdmod/chat/api/
UKY_RAG_TIMEOUT=60.0

# Legacy: Citation validation and local RAG (deprecated)
# These are no longer used - Q&A service handles this
# REDIS_URL=redis://localhost:6379/0
# CITATION_VALIDATION_ENABLED=true
# RAG_FALLBACK_ENABLED=true
# EMBEDDING_MODEL=sentence-transformers/all-MiniLM-L6-v2
# EMBEDDING_DIMENSIONS=384

# MCP Configuration
MCP_CATALOG_PATH=mcp-tool-catalog.json  # Local catalog file
# MCP_CATALOG_URL=http://localhost:5678/webhook/generate-mcp-catalog  # Or fetch from URL

# =============================================================================
# Reporting (GA4 + Email/Slack delivery)
# =============================================================================
# GA4 Property ID (numeric, from Admin > Property Details)
GA4_PROPERTY_ID=326843153
# Path to GCP service account JSON key file
GA4_CREDENTIALS_FILE=mghpcc-4626301de758.json

# Email delivery (Mailgun API)
MAILGUN_API_KEY=your-mailgun-api-key
MAILGUN_DOMAIN=mg.sweetandfizzy.com
REPORT_EMAIL_FROM=reports@mg.sweetandfizzy.com
REPORT_EMAIL_TO=andrew@elytra.net

# Slack delivery
# REPORT_SLACK_WEBHOOK_URL=https://hooks.slack.com/services/xxx/yyy/zzz

# =============================================================================
# Capability registry
# =============================================================================
# ENABLED_CAPABILITIES / DISABLED_CAPABILITIES: comma-separated capability IDs.
# Deny wins. See src/agent/domains/capabilities.py for full semantics.
# ENABLED_CAPABILITIES=
# DISABLED_CAPABILITIES=
#
# READ_ONLY=true disables all write-capable capabilities at startup
# (manage_announcements, open_ticket, report_login_problem, report_security).
# Recommended for staging and for any deploy where accidental writes would
# be unacceptable. Default false. See docs/security/write-capability-audit.md.
# READ_ONLY=false

# USE_TOOL_CALLING_LOOP=true routes tool-using queries through the new
# single-node tool_calling_loop (LLM-driven react loop) instead of the
# legacy plan+execute+evaluate+recover+synthesize chain. Default false;
# flip true in staging before cutover. See launch spec Phase 3.
# USE_TOOL_CALLING_LOOP=false

# Quality Loop
MAX_QUALITY_ATTEMPTS=3

# Synthesis Settings
# Token budget for tool results before condensation (default 80K for gpt-4o's 128K context)
# Reduce for smaller models (e.g., 20000 for Mistral-7B with 32K context)
SYNTHESIS_TOKEN_BUDGET=80000
