# .env.eval.prod.example — template for scripts/eval-prod runs against production.
#
# Copy to .env.eval.prod (gitignored — never commit the filled file) and fill in
# real values. scripts/eval-prod refuses to run unless ENVIRONMENT=production and
# DATABASE_URL is set, and src/config.py's fail-closed data-residency guard raises
# at import time unless LLM_PROVIDER=vllm and EVAL_JUDGE_BASE_URL is set — a
# production eval must never send data to a commercial API.
#
# Prod Postgres is reached over an SSH tunnel. The remote side listens on 5433:
#   EVAL_PROD_DB_REMOTE_PORT=5433 ./scripts/eval-tunnel-open
# then DATABASE_URL points at localhost:5432 below.

ENVIRONMENT=production

# --- Agent under test: UKY vLLM (data residency: on-prem only) ---
LLM_PROVIDER=vllm
VLLM_BASE_URL=https://jump-external.ccs.uky.edu/v1
VLLM_API_KEY=changeme
# Incumbent (thinking) model. The multi-turn/single-turn A/B swaps ONLY this value:
#   incumbent: ccs/Qwen/Qwen3.6-35B-A3B-FP8
#   nothink:   ccs/Qwen/Qwen3.6-35B-A3B-FP8-nothink  (same checkpoint, thinking
#              disabled at UKY's serving layer — verify it answers before a run)
VLLM_MODEL_NAME=ccs/Qwen/Qwen3.6-35B-A3B-FP8

# --- Judge: held constant across variants (never swap with VLLM_MODEL_NAME) ---
EVAL_JUDGE_BASE_URL=https://jump-external.ccs.uky.edu/v1
EVAL_JUDGE_API_KEY=changeme
EVAL_JUDGE_MODEL=ccs/Qwen/Qwen3.6-35B-A3B-FP8
EVAL_JUDGE_THINKING=true

# --- Eval database (prod Postgres via the tunnel above) ---
DATABASE_URL=postgresql://user:changeme@localhost:5432/langgraph

# --- MCP servers (prod) ---
MCP_SERVER_HOST=http://45.79.215.140
MCP_API_KEY=changeme

# --- UKY RAG (document retrieval tool) ---
UKY_RAG_ENABLED=true
UKY_RAG_GENERAL_URL=changeme
UKY_RAG_XDMOD_URL=changeme
UKY_RAG_API_KEY=changeme

# --- Misc ---
OTEL_ENABLED=false

# Retired: ARGILLA_URL / ARGILLA_API_KEY / ARGILLA_EVAL_DATASET (Argilla is gone;
# fact review lives in the reporting dashboard), OPENAI_API_KEY / OPENAI_MODEL
# (never used in production eval — the residency guard forbids the openai provider).
