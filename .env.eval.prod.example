# Production eval environment — fill in values and save as .env.eval.prod
#
# This file is loaded by scripts/eval-prod when running the two-way
# baseline comparison described in access-qa-planning/decisions/007-
# production-baseline-comparison.md. It is intentionally separate from
# the main .env so prod eval runs cannot accidentally use local values.
#
# The wrapper refuses to run unless ENVIRONMENT=production is set here.

# ── Environment marker ────────────────────────────────────────────────
# The wrapper script asserts this. Do not change.
ENVIRONMENT=production

# ── Database ──────────────────────────────────────────────────────────
# Eval runs and scores are written here. Prod Postgres lives in a
# Docker container on mcp.access-ci.org and is not directly reachable
# from a workstation, so open an SSH tunnel first:
#
#   ./scripts/eval-tunnel-open
#
# Then DATABASE_URL points at the tunneled local port.
DATABASE_URL=postgresql://USER:PASS@localhost:5432/DB_NAME

# ── MCP servers ───────────────────────────────────────────────────────
MCP_SERVER_HOST=mcp.access-ci.org
MCP_CATALOG_URL=https://REPLACE_WITH_PROD_CATALOG_URL
# Alternatively, use a static snapshot file (uncomment and set):
# MCP_CATALOG_PATH=/path/to/catalog-snapshot.json

# MCP API key. Write-op MCP servers require this. Eval is effectively
# read-only but setting it avoids surprises if any code path hits a
# write-capable server.
MCP_API_KEY=REPLACE_WITH_PROD_MCP_API_KEY

# ── UKY RAG endpoints ─────────────────────────────────────────────────
UKY_RAG_ENABLED=true
UKY_RAG_GENERAL_URL=https://access-ai-grace1-external.ccs.uky.edu/access/chat/api/
UKY_RAG_XDMOD_URL=https://access-ai-grace1-external.ccs.uky.edu/access/xdmod/chat/api/
UKY_RAG_API_KEY=REPLACE_WITH_PROD_UKY_RAG_KEY

# ── Agent LLM ─────────────────────────────────────────────────────────
OPENAI_API_KEY=sk-REPLACE
OPENAI_MODEL=gpt-4o
LLM_PROVIDER=openai

# ── Eval judge ────────────────────────────────────────────────────────
# Empty EVAL_JUDGE_BASE_URL = use OpenAI default.
# Empty EVAL_JUDGE_API_KEY = fall back to OPENAI_API_KEY.
EVAL_JUDGE_MODEL=gpt-4o-mini
# EVAL_JUDGE_BASE_URL=
# EVAL_JUDGE_API_KEY=

# ── Argilla ───────────────────────────────────────────────────────────
# Prod Argilla instance. The dedicated dataset keeps the baseline
# comparison separate from ongoing eval-production scoring.
ARGILLA_URL=https://REPLACE_WITH_PROD_ARGILLA_URL
ARGILLA_API_KEY=REPLACE_WITH_PROD_ARGILLA_KEY
ARGILLA_EVAL_DATASET=eval-baseline-comparison

# ── Capability registry filter ────────────────────────────────────────
# Leave unset for the full-capabilities run. For the RAG-only run, the
# wrapper will set this value automatically when invoked with --rag-only.
# ENABLED_CAPABILITIES=

# ── OpenTelemetry ─────────────────────────────────────────────────────
# Disabled for eval runs so eval traffic doesn't pollute the main
# Honeycomb dataset. Re-enable and route to a separate dataset if you
# want traces from eval runs.
OTEL_ENABLED=false
